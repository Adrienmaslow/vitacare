# ---------------------------------------------------------------
# BUDGETLY — variables d'environnement (copier en .env.local)
# Aucune de ces valeurs ne doit être commitée.
# ---------------------------------------------------------------

# URL publique de l'application (redirections d'emails / OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (obligatoire pour les vrais comptes ; sans ces valeurs seul le mode démo fonctionne)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service : SERVEUR UNIQUEMENT. Utilisée pour la suppression de compte.
SUPABASE_SERVICE_ROLE_KEY=

# Affiche le bouton "Continuer avec Google" (le fournisseur doit être activé dans Supabase)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# France Travail — API Offres d'emploi v2 (facultatif, accès à demander sur francetravail.io)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Coach IA facultatif (niveau 2). Sans clé, le coach déterministe reste pleinement fonctionnel.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Secret pour la route de tâches planifiées (/api/cron/alerts)
CRON_SECRET=
